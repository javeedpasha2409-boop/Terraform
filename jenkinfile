pipeline {
    agent any

    tools {
        nodejs 'NodeJS-18'
    }

    environment {
        NODE_OPTIONS = '--openssl-legacy-provider'
        CI = 'false'
    }

    stages {
        stage('Git Checkout') {
            steps {
                git 'https://github.com/javeedpasha2409-boop/Terraform.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Build Application') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Deploy Application') {
            steps {
                sh 'pm2 delete Trading-UI || true'
                sh 'pm2 start npm --name "Trading-UI" -- start'
            }
        }
    }
}
